+//! Xtensa C ABI classification (windowed and call0).
+//!
+//! Aggregates are passed in up to 6 argument registers and returned in up to 4 registers,
+//! as one `i32`, an array of `i32`, or an array of `i64` for 8-byte aligned types. An
+//! aggregate that does not fit the remaining registers is passed on the stack, or returned
+//! through a hidden pointer. Scalars are left to LLVM.
+const std = @import("std");
+const Type = @import("../../Type.zig");
+const Zcu = @import("../../Zcu.zig");
+
+pub const max_arg_gprs = 6;
+pub const max_ret_gprs = 4;
+
+pub const Class = union(enum) {
+    memory,
+    byval,
+    i32_array: u8,
+    i64_array: u8,
+};
+
+pub const Context = enum { ret, arg };
+
+/// `gprs_left` is the number of argument registers still free before this type, and is
+/// decreased by the registers this type consumes.
+pub fn classifyType(ty: Type, zcu: *Zcu, gprs_left: *u8, ctx: Context) Class {
+    const max_gprs: u8 = switch (ctx) {
+        .arg => max_arg_gprs,
+        .ret => max_ret_gprs,
+    };
+    const size_bits = ty.abiSize(zcu) * 8;
+    const align_bits = ty.abiAlignment(zcu).toByteUnits().? * 8;
+
+    var needed: u64 = std.math.divCeil(u64, size_bits, 32) catch unreachable;
+    if (align_bits == 64) needed += gprs_left.* % 2;
+    const must_use_stack = needed > gprs_left.* or
+        align_bits > 128 or
+        (gprs_left.* < max_gprs and align_bits == 128);
+    if (must_use_stack) needed = gprs_left.*;
+    gprs_left.* -= @intCast(needed);
+
+    const is_aggregate = switch (ty.zigTypeTag(zcu)) {
+        .@"struct" => ty.containerLayout(zcu) != .@"bitpack",
+        .@"union" => zcu.typeToUnion(ty).?.layout != .@"bitpack",
+        else => false,
+    };
+    if (!is_aggregate) {
+        if (ctx == .ret and size_bits > max_ret_gprs * 32) return .memory;
+        return .byval;
+    }
+    if (must_use_stack) return .memory;
+    if (size_bits <= 32) return .{ .i32_array = 1 };
+    if (align_bits == 64) return .{ .i64_array = @intCast(std.math.divCeil(u64, size_bits, 64) catch unreachable) };
+    return .{ .i32_array = @intCast(std.math.divCeil(u64, size_bits, 32) catch unreachable) };
+}
